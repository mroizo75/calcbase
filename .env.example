# Base URL for canonical URLs and sitemap
NEXT_PUBLIC_BASE_URL=https://calcbase.com

# Google AdSense – set to "true" to enable ad slots
NEXT_PUBLIC_ADS_ENABLED=false

# Google AdSense Publisher ID (e.g. ca-pub-1234567890)
NEXT_PUBLIC_ADSENSE_PUB_ID=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Optional server alias (same value)
SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Required for private datasets — /news will be empty without a read/write token
SANITY_API_READ_TOKEN=
# Server-only write token for SEO opportunity cron/apply (can also be used as read token)
SANITY_API_WRITE_TOKEN=

# Vercel cron + SEO apply/revalidate auth
CRON_SECRET=

# Google Search Console (service account with webmasters.readonly on the property)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key with literal \n escaped newlines when stored in env
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Default: sc-domain:calcbase.io
GSC_SITE_URL=sc-domain:calcbase.io

# Optional: title/meta suggestions + article DRAFTS for human review (never auto-publish)
OPENAI_API_KEY=
# OPENAI_SEO_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1
